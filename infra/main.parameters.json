{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "staticWebAppSku": {
      "value": "${STATIC_WEB_APP_SKU=Free}"
    },
    "azureOpenAIEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT}"
    },
    "azureOpenAIApiKey": {
      "value": "${AZURE_OPENAI_API_KEY}"
    },
    "advisorEndpoint": {
      "value": "${ADVISOR_ENDPOINT=}"
    },
    "advisorApiKey": {
      "value": "${ADVISOR_API_KEY=}"
    },
    "advisorApiRoute": {
      "value": "${ADVISOR_API_ROUTE=openai_v1}"
    },
    "realtimeDeployment": {
      "value": "${REALTIME_DEPLOYMENT=gpt-realtime-2}"
    },
    "realtimeNoiseReduction": {
      "value": "${REALTIME_NOISE_REDUCTION=far_field}"
    },
    "advisorDeployment": {
      "value": "${ADVISOR_DEPLOYMENT=grok-4-20-non-reasoning}"
    },
    "avatarTextDeployment": {
      "value": "${AVATAR_TEXT_DEPLOYMENT=gpt-5.4-nano}"
    },
    "transcriptionDeployment": {
      "value": "${TRANSCRIPTION_DEPLOYMENT=gpt-4o-mini-transcribe}"
    },
    "zatsucoachAuthSecret": {
      "value": "${ZATSUCOACH_AUTH_SECRET=}"
    },
    "zatsucoachDemoEmail": {
      "value": "${ZATSUCOACH_DEMO_EMAIL=demo2026@catkawaii.com}"
    },
    "zatsucoachDemoPasswordHash": {
      "value": "${ZATSUCOACH_DEMO_PASSWORD_HASH=}"
    },
    "zatsucoachDeveloperEmails": {
      "value": "${ZATSUCOACH_DEVELOPER_EMAILS=developer@example.com}"
    }
  }
}
